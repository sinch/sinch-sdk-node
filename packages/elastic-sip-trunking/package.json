{
  "name": "@sinch/elastic-sip-trunking",
  "version": "1.5.0",
  "description": "Sinch Elastic SIP Trunking API (deprecated; will be removed in SDK version 2)",
  "homepage": "",
  "repository": {
    "type": "git"
  },
  "license": "Apache-2.0",
  "author": "Sinch",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "directories": {
    "src": "dist",
    "test": "tests"
  },
  "files": [
    "/dist"
  ],
  "scripts": {
    "build": "yarn run clean && yarn run compile",
    "clean": "rimraf dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo",
    "compile": "tsc -p tsconfig.build.json && tsc -p tsconfig.tests.json && rimraf dist/tests tsconfig.build.tsbuildinfo",
    "test:e2e": "TS_NODE_PROJECT=tsconfig.tests.json cucumber-js"
  },
  "dependencies": {
    "@sinch/sdk-client": "1.5.0"
  },
  "devDependencies": {},
  "publishConfig": {
    "directory": "dist",
    "access": "public"
  }
}

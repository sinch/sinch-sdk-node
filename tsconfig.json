{
  "compilerOptions": {
    "sourceMap": true,
    "removeComments": false,
    "lib": ["ES2022"],
    "strict": true,
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "pretty": true,
    "resolveJsonModule": true,
    "types": ["jest", "node"],
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useDefineForClassFields": false,
    "declaration": true,
    "composite": true,
    "noEmit": true
  },
  "include": [],
  "exclude": [
    "node_modules",
    "**/node_modules",
    "**/dist",
    "docs",
    "**/cucumber.js"
  ],
  "ts-node": {
    "esm": true
  }
}
